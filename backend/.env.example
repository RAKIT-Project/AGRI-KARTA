# ==============================================================================
# BACKEND / FASTAPI (.env)
# Lokasi: ./rakit-project/agri-karta/AGRI-KARTA-259e8865d9a4c27834c61eb1b800baf1edd235cc/backend/.env
# ==============================================================================

# ── SUPABASE CONFIGURATION (Admin/Service) ───────────────────
# Diambil dari Supabase Dashboard > Project Settings > API
SUPABASE_URL="https://your-project-id.supabase.co"
# PENTING: Gunakan Service Role Key. Kunci ini bisa mem-bypass Row Level Security (RLS)
# untuk keperluan sinkronisasi cron job & webhook database.
SUPABASE_SERVICE_KEY="your-service-role-key"

# ── WABLAS WHATSAPP API ──────────────────────────────────────
# Diambil dari Dashboard Wablas Anda
WABLAS_DOMAIN="https://jogja.wablas.com" # Sesuaikan dengan domain server Wablas Anda
WABLAS_API_TOKEN="your-wablas-token-here"

# ── GOOGLE GEMINI AI ─────────────────────────────────────────
# Digunakan untuk AI Prediction Engine di backend (agar API Key tidak bocor ke klien)
GEMINI_API_KEY="your-gemini-api-key"

# ── SECURITY & CRON ──────────────────────────────────────────
# String acak untuk mengamankan endpoint /cron agar tidak bisa dipanggil sembarang orang
CRON_SECRET="your-secure-random-string-for-cron-auth"
